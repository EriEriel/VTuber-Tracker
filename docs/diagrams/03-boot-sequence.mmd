flowchart TB
  A["assertApiTokenConfigured()"] --> B{"NODE_ENV=production<br/>and no API_TOKEN?"}
  B -->|yes| X["process.exit(1)<br/><small>refuse to serve an open API</small>"]
  B -->|no| C["new Hono()"]
  C --> D["app.use('/api/*', requireApiToken)<br/>app.use('/sync/*', requireApiToken)"]
  D --> E["mount vtubers &middot; sync &middot; eventsub<br/><small>/eventsub/* deliberately outside the gate</small>"]
  E --> F["await connectToDatabase()"]
  F --> G{"connected?"}
  G -->|no| X2["process.exit(1)<br/><small>one clean line, not a Mongoose dump</small>"]
  G -->|yes| H["initTwitchEventSub()<br/><small>fire-and-forget reconcile</small>"]
  H --> I["startYoutubeLivePoller()<br/><small>immediate cycle, then every 5 min</small>"]
  I --> J["startStatsSyncPoller()<br/><small>immediate cycle, then every 6 h</small>"]
  J --> K["Bun.serve({ port, idleTimeout: 120 })"]

  classDef ok   fill:#d3f9d8,stroke:#2b8a3e,color:#0b2e13;
  classDef gate fill:#fff3bf,stroke:#a1690b,color:#4a3200;
  classDef bad  fill:#ffe3e3,stroke:#c92a2a,color:#4d0f0f;

  class A,C,D,E,F,H,I,J,K ok;
  class B,G gate;
  class X,X2 bad;

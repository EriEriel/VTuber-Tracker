flowchart LR
  subgraph EXT["&nbsp;external sources&nbsp;"]
    direction TB
    HD["HoloDex<br/><small>channels &middot; videos<br/>clips &middot; live</small>"]
    YT["YouTube Data API<br/><small>channels &middot; videos<br/>+ zero-quota RSS</small>"]
    TW["Twitch Helix<br/><small>users &middot; streams &middot; clips<br/>+ EventSub</small>"]
  end

  subgraph BE["&nbsp;backend &mdash; Bun + Hono&nbsp;"]
    direction TB
    subgraph BOOT["&nbsp;timers &amp; boot&nbsp;"]
      SCH["scheduler.ts"]
      ES["twitch-eventsub.ts"]
    end
    RT["routes/<br/><small>vtubers &middot; sync<br/>eventsub</small>"]
    SY["sync.ts<br/>+ mappers/"]
    LS["live-state.ts"]
  end

  DB[("MongoDB Atlas<br/><small>VTuber &middot; Stream<br/>Clip &middot; StatSnapshot</small>")]

  subgraph CL["&nbsp;oshihub &mdash; Rust&nbsp;"]
    direction TB
    CLI["main.rs<br/><small>list &middot; lookup<br/>live &middot; jump</small>"]
    WATCH["watch.rs<br/><small>poll &rarr; notify-send</small>"]
    TUI["tui/<br/><small>ratatui UI</small>"]
  end

  CLI --> RT
  WATCH --> RT
  TUI --> RT
  TW -.->|"webhook"| RT

  RT --> SY
  RT --> LS
  RT --> DB
  SCH --> SY
  SCH --> LS
  ES --> TW
  SY --> HD
  SY --> YT
  SY --> TW
  SCH --> HD
  SCH --> YT
  SY --> DB
  LS --> DB

  classDef ext     fill:#f3d9fa,stroke:#862e9c,color:#3b0764,stroke-width:1px;
  classDef timer   fill:#fff3bf,stroke:#a1690b,color:#4a3200,stroke-width:1px;
  classDef ingress fill:#d0ebff,stroke:#1864ab,color:#0a2d4d,stroke-width:1px;
  classDef write   fill:#d3f9d8,stroke:#2b8a3e,color:#0b2e13,stroke-width:1px;
  classDef store   fill:#c5f6fa,stroke:#0b7285,color:#062e35,stroke-width:1px;
  classDef client  fill:#e7f5ff,stroke:#1864ab,color:#0a2d4d,stroke-width:1px;

  class HD,YT,TW ext;
  class SCH,ES timer;
  class RT ingress;
  class SY,LS write;
  class DB store;
  class CLI,WATCH,TUI client;
